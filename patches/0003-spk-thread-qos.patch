+#if defined(__APPLE__)
+// SPK: inference must not be demoted to a background QoS class. iOS lowers the
+// QoS of threads spawned while the app is not foreground, which caps them at the
+// efficiency cores and roughly doubles token latency on A-series chips.
+#include <pthread/qos.h>
+static bool spk_qos_enabled(void) {
+    const char * v = getenv("SPK_DISABLE_QOS");
+    return v == NULL || v[0] == '0';
+}
+#endif
