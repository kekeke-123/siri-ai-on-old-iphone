 // ---------------------------------------------------------------- paths
 
+namespace {
+
+// "absolute" has to mean the same thing on every host: POSIX roots at '/',
+// Windows at a drive letter or a UNC prefix. The kernel is portable, so the
+// path policy is too - a Windows build must not refuse C:\models\q.gguf.
+bool spk_path_is_absolute(const char * path) {
+    if (path == nullptr || path[0] == '\0') {
+        return false;
+    }
+#if defined(_WIN32)
+    if (path[0] == '\\' && path[1] == '\\') {          // \\server\share
+        return true;
+    }
+    if (path[0] == '/' || path[0] == '\\') {
+        return true;
+    }
+    return (std::isalpha((unsigned char) path[0]) != 0) &&
+           path[1] == ':' &&
+           (path[2] == '\\' || path[2] == '/');
+#else
+    return path[0] == '/';
+#endif
+}
+
+} // namespace
